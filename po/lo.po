#: modules/gui/qt/qt.cpp:102
msgid "Show the name of the song or video in the controller window title."
msgstr "ສະແດງຊື່ເພງ ຫຼື ວິດີໂອໃນຫົວຂໍ້ໜ້າຕ່າງສ່ວນຄວບຄຸມ."

#: modules/gui/qt/qt.cpp:105
msgid "Show notification popup on track change"
msgstr "ສະແດງການແຈ້ງເຕືອນເມື່ອປ່ຽນແທຣັກ"

#: modules/gui/qt/qt.cpp:107
msgid ""
"Show a notification popup with the artist and track name when the current "
"playlist item changes, when VLC is minimized or hidden."
msgstr "ສະແດງການແຈ້ງເຕືອນພ້ອມກັບຊື່ສິລະປິນ ແລະ ຊື່ແທຣັກ ເມື່ອລາຍການໃນລາຍຊື່ຫຼິ້ນປ່ຽນໄປ, ໃນຂະນະທີ່ VLC ຖືກຍໍ້ລົງ ຫຼື ຖືກເຊື່ອງໄວ້."

#: modules/gui/qt/qt.cpp:110
msgid "Windows opacity between 0.1 and 1"
msgstr "ຄວາມໂປ່ງໃສຂອງໜ້າຕ່າງລະຫວ່າງ 0.1 ຫາ 1"

#: modules/gui/qt/qt.cpp:111
msgid ""
"Sets the windows opacity between 0.1 and 1 for main interface, playlist and "
"extended panel. This option only works with Windows and X11 with composite "
"extensions."
msgstr "ກໍານົດຄວາມໂປ່ງໃສຂອງໜ້າຕ່າງລະຫວ່າງ 0.1 ຫາ 1 ສໍາລັບສ່ວນຕິດຕໍ່ຜູ້ໃຊ້ຫຼັກ, ລາຍຊື່ຫຼິ້ນ ແລະ ແຜງຂະຫຍາຍ. ຕົວເລືອກນີ້ໃຊ້ໄດ້ກັບ Windows ແລະ X11 ທີ່ມີສ່ວນຂະຫຍາຍ composite ເທົ່ານັ້ນ."

#: modules/gui/qt/qt.cpp:116
msgid "Fullscreen controller opacity between 0.1 and 1"
msgstr "ຄວາມໂປ່ງໃສຂອງສ່ວນຄວບຄຸມເຕັມຈໍລະຫວ່າງ 0.1 ຫາ 1"

#: modules/gui/qt/qt.cpp:117
msgid ""
"Sets the fullscreen controller opacity between 0.1 and 1 for main interface, "
"playlist and extended panel. This option only works with Windows and X11 "
"with composite extensions."
msgstr "ກໍານົດຄວາມໂປ່ງໃສຂອງສ່ວນຄວບຄຸມເຕັມຈໍລະຫວ່າງ 0.1 ຫາ 1 ສໍາລັບສ່ວນຕິດຕໍ່ຜູ້ໃຊ້ຫຼັກ, ລາຍຊື່ຫຼິ້ນ ແລະ ແຜງຂະຫຍາຍ. ຕົວເລືອກນີ້ໃຊ້ໄດ້ກັບ Windows ແລະ X11 ທີ່ມີສ່ວນຂະຫຍາຍ composite ເທົ່ານັ້ນ."

#: modules/gui/qt/qt.cpp:122
msgid "Show unimportant error and warnings dialogs"
msgstr "ສະແດງໜ້າຕ່າງຂໍ້ຜິດພາດ ແລະ ຄໍາເຕືອນທີ່ບໍ່ສໍາຄັນ"

#: modules/gui/qt/qt.cpp:124
msgid "Activate the updates availability notification"
msgstr "ເປີດການແຈ້ງເຕືອນການອັບເດດທີ່ມີໃຫ້"

#: modules/gui/qt/qt.cpp:125
msgid ""
"Activate the automatic notification of new versions of the software. It runs "
"once every two weeks."
msgstr "ເປີດການແຈ້ງເຕືອນອັດຕະໂນມັດສໍາລັບເວີຊັນໃໝ່ຂອງຊອບແວ. ມັນຈະເຮັດວຽກໜຶ່ງຄັ້ງໃນທຸກໆສອງອາທິດ."

#: modules/gui/qt/qt.cpp:128
msgid "Number of days between two update checks"
msgstr "ຈໍານວນມື້ລະຫວ່າງການກວດສອບການອັບເດດສອງຄັ້ງ"

#: modules/gui/qt/qt.cpp:130
msgid "Ask for network policy at start"
msgstr "ຖາມຫາການກໍານົດນະໂຍບາຍເຄືອຂ່າຍເມື່ອເລີ່ມຕົ້ນ"

#: modules/gui/qt/qt.cpp:132
msgid "Save the recently played items in the menu"
msgstr "ບັນທຶກລາຍການທີ່ຫາກໍ່ຫຼິ້ນໃນເມນູ"

#: modules/gui/qt/qt.cpp:134
msgid "List of words separated by | to filter"
msgstr "ລາຍຊື່ຄໍາສັບທີ່ແຍກດ້ວຍ | ເພື່ອກັ່ນຕອງ"

#: modules/gui/qt/qt.cpp:135
msgid ""
"Regular expression used to filter the recent items played in the player."
msgstr "ນິພົດປົກກະຕິທີ່ໃຊ້ເພື່ອກັ່ນຕອງລາຍການທີ່ຫາກໍ່ຫຼິ້ນໃນເຄື່ອງຫຼິ້ນ."

#: modules/gui/qt/qt.cpp:138
msgid "Define the colors of the volume slider"
msgstr "ກໍານົດສີຂອງແຖບເລື່ອນສຽງ"

#: modules/gui/qt/qt.cpp:139
msgid ""
"Define the colors of the volume slider\n"
"By specifying the 12 numbers separated by a ';'\n"
"Default is '255;255;255;20;226;20;255;176;15;235;30;20'\n"
"An alternative can be '30;30;50;40;40;100;50;50;160;150;150;255'"
msgstr ""
"ກໍານົດສີຂອງແຖບເລື່ອນສຽງ\n"
"ໂດຍການລະບຸຕົວເລກ 12 ຕົວແຍກດ້ວຍ ';'\n"
"ຄ່າເລີ່ມຕົ້ນແມ່ນ '255;255;255;20;226;20;255;176;15;235;30;20'\n"
"ທາງເລືອກອື່ນອາດຈະແມ່ນ '30;30;50;40;40;100;50;50;160;150;150;255'"

#: modules/gui/qt/qt.cpp:144
msgid "Selection of the starting mode and look"
msgstr "ການເລືອກໂໝດເລີ່ມຕົ້ນ ແລະ ຮູບລັກສະນະ"

#: modules/gui/qt/qt.cpp:145
msgid ""
"Start VLC with:\n"
" - normal mode\n"
" - a zone always present to show information as lyrics, album arts...\n"
" - minimal mode with limited controls"
msgstr ""
"ເລີ່ມ VLC ດ້ວຍ:\n"
" - ໂໝດປົກກະຕິ\n"
" - ເຂດທີ່ສະແດງຂໍ້ມູນຢູ່ສະເໝີ ເຊັ່ນ ເນື້ອເພງ, ຮູບໜ້າປົກອັນບັ້ມ...\n"
" - ໂໝດແບບຫຍໍ້ດ້ວຍສ່ວນຄວບຄຸມທີ່ຈໍາກັດ"

#: modules/gui/qt/qt.cpp:151
msgid "Show a controller in fullscreen mode"
msgstr "ສະແດງສ່ວນຄວບຄຸມໃນໂໝດເຕັມຈໍ"

#: modules/gui/qt/qt.cpp:152
msgid "Embed the file browser in open dialog"
msgstr "ຝັງຕົວທ່ອງໄຟລ໌ໃນໜ້າຕ່າງການເປີດ"

#: modules/gui/qt/qt.cpp:154
msgid "Define which screen fullscreen goes"
msgstr "ກໍານົດວ່າຈະໃຫ້ສະແດງເຕັມຈໍຢູ່ຈໍໃດ"

#: modules/gui/qt/qt.cpp:155
msgid "Screennumber of fullscreen, instead of same screen where interface is."
msgstr "ໝາຍເລກຈໍຂອງການສະແດງເຕັມຈໍ, ແທນທີ່ຈະເປັນຈໍດຽວກັນກັບສ່ວນຕິດຕໍ່ຜູ້ໃຊ້."

#: modules/gui/qt/qt.cpp:158
msgid "Load extensions on startup"
msgstr "ໂຫຼດສ່ວນຂະຫຍາຍເມື່ອເລີ່ມຕົ້ນ"

#: modules/gui/qt/qt.cpp:159
msgid "Automatically load the extensions module on startup."
msgstr "ໂຫຼດໂມດູນສ່ວນຂະຫຍາຍໂດຍອັດຕະໂນມັດເມື່ອເລີ່ມຕົ້ນ."

#: modules/gui/qt/qt.cpp:162
msgid "Start in minimal view (without menus)"
msgstr "ເລີ່ມຕົ້ນໃນມຸມມອງແບບຫຍໍ້ (ບໍ່ມີເມນູ)"

#: modules/gui/qt/qt.cpp:164
msgid "Display background cone or art"
msgstr "ສະແດງຮູບຈວຍພື້ນຫຼັງ ຫຼື ຮູບສິລະປະ"

#: modules/gui/qt/qt.cpp:165
msgid ""
"Display background cone or current album art when not playing. Can be "
"disabled to prevent burning screen."
msgstr "ສະແດງຮູບຈວຍພື້ນຫຼັງ ຫຼື ຮູບໜ້າປົກອັນບັ້ມປັດຈຸບັນເມື່ອບໍ່ໄດ້ຫຼິ້ນ. ສາມາດປິດຕົວເລືອກນີ້ໄດ້ເພື່ອປ້ອງກັນຈໍໄໝ້."

#: modules/gui/qt/qt.cpp:168
msgid "Expanding background cone or art"
msgstr "ຂະຫຍາຍຮູບຈວຍພື້ນຫຼັງ ຫຼື ຮູບສິລະປະ"

#: modules/gui/qt/qt.cpp:169
msgid "Background art fits window's size."
msgstr "ຮູບສິລະປະພື້ນຫຼັງໃຫ້ພໍດີກັບຂະໜາດໜ້າຕ່າງ."

#: modules/gui/qt/qt.cpp:171
msgid "Ignore keyboard volume buttons."
msgstr "ບໍ່ສົນໃຈປຸ່ມປັບສຽງເທິງຄີບອດ."

#: modules/gui/qt/qt.cpp:173
msgid ""
"With this option checked, the volume up, volume down and mute buttons on "
"your keyboard will always change your system volume. With this option "
"unchecked, the volume buttons will change VLC's volume when VLC is selected "
"and change the system volume when VLC is not selected."
msgstr "ເມື່ອໝາຍຕິກເອົາຕົວເລືອກນີ້, ປຸ່ມເພີ່ມສຽງ, ຫຼຸດສຽງ ແລະ ປິດສຽງເທິງຄີບອດຂອງທ່ານຈະປ່ຽນສຽງຂອງລະບົບສະເໝີ. ຫາກບໍ່ໄດ້ໝາຍຕິກ, ປຸ່ມປັບສຽງຈະປ່ຽນສຽງຂອງ VLC ເມື່ອເລືອກ VLC ຢູ່ ແລະ ປ່ຽນສຽງຂອງລະບົບເມື່ອບໍ່ໄດ້ເລືອກ VLC."

#: modules/gui/qt/qt.cpp:188
msgid "When to raise the interface"
msgstr "ເວລາທີ່ຈະນໍາສ່ວນຕິດຕໍ່ຜູ້ໃຊ້ຂຶ້ນມາ"

#: modules/gui/qt/qt.cpp:189
msgid ""
"This option allows the interface to be raised automatically when a video/"
"audio playback starts, or never."
msgstr "ຕົວເລືອກນີ້ອະນຸຍາດໃຫ້ສ່ວນຕິດຕໍ່ຜູ້ໃຊ້ຖືກຍົກຂຶ້ນມາໂດຍອັດຕະໂນມັດເມື່ອການຫຼິ້ນວິດີໂອ/ສຽງເລີ່ມຕົ້ນ, ຫຼື ບໍ່ເລີຍ."

#: modules/gui/qt/qt.cpp:192
msgid "Fullscreen controller mouse sensitivity"
msgstr "ຄວາມໄວຂອງເມົາສ໌ສໍາລັບສ່ວນຄວບຄຸມເຕັມຈໍ"

