msgstr "ຂໍ້ຜິດພາດ ແລະ ຄຳເຕືອນ"

#: modules/gui/macosx/VLCErrorWindowController.m:56
msgid "Clean up"
msgstr "ລ້າງອອກ"

#: modules/gui/macosx/VLCFSPanelController.m:110
msgid "Play/Pause the current media"
msgstr "ຫຼິ້ນ/ຢຸດສື່ປັດຈຸບັນ"

#: modules/gui/macosx/VLCFSPanelController.m:116
msgid "Go to the previous item"
msgstr "ໄປຫາລາຍການກ່ອນໜ້າ"

#: modules/gui/macosx/VLCFSPanelController.m:124
msgid "Toggle Fullscreen mode"
msgstr "ສະຫຼັບໂໝດເຕັມຈໍ"

#: modules/gui/macosx/VLCFSPanelController.m:125
msgid "Leave fullscreen mode"
msgstr "ອອກຈາກໂໝດເຕັມຈໍ"

#: modules/gui/macosx/VLCFSPanelController.m:127
#: modules/gui/macosx/VLCMainWindowControlsBar.m:76
#: modules/gui/qt/dialogs/toolbar.cpp:468 modules/gui/qt/ui/sprefs_audio.h:427
msgid "Volume"
msgstr "ລະດັບສຽງ"

#: modules/gui/macosx/VLCFSPanelController.m:128
msgid "Adjust the volume"
msgstr "ປັບລະດັບສຽງ"

#: modules/gui/macosx/VLCFSPanelController.m:131
msgid "Adjust the current playback position"
msgstr "ປັບຕຳແໜ່ງການຫຼິ້ນປັດຈຸບັນ"

#: modules/gui/macosx/macosx.m:51
msgid "Video device"
msgstr "ອຸປະກອນວິດີໂອ"

#: modules/gui/macosx/macosx.m:52
msgid ""
"Number of the screen to use by default to display videos in 'fullscreen'. "
"The screen number correspondance can be found in the video device selection "
"menu."
msgstr "ໝາຍເລກໜ້າຈໍທີ່ຈະໃຊ້ເປັນຄ່າເລີ່ມຕົ້ນສຳລັບການສະແດງຜົນ 'ເຕັມຈໍ'."

#: modules/gui/macosx/macosx.m:56
msgid "Opaqueness"
msgstr "ຄວາມທຶບແສງ"

#: modules/gui/macosx/macosx.m:57
msgid ""
"Set the transparency of the video output. 1 is non-transparent (default) 0 "
"is fully transparent."
msgstr "ຕັ້ງຄ່າຄວາມໂປ່ງໃສຂອງວິດີໂອ. 1 ຄືບໍ່ໂປ່ງໃສ (ຄ່າເລີ່ມຕົ້ນ) 0 ຄືໂປ່ງໃສທັງໝົດ."

#: modules/gui/macosx/macosx.m:60
msgid "Black screens in fullscreen"
msgstr "ໜ້າຈໍດຳໃນໂໝດເຕັມຈໍ"

#: modules/gui/macosx/macosx.m:61
msgid "In fullscreen mode, keep screen where there is no video displayed black"
msgstr "ໃນໂໝດເຕັມຈໍ, ໃຫ້ໜ້າຈໍທີ່ບໍ່ມີການສະແດງວິດີໂອເປັນສີດຳ"

#: modules/gui/macosx/macosx.m:64
msgid "Show Fullscreen controller"
msgstr "ສະແດງຕົວຄວບຄຸມການເຕັມຈໍ"

#: modules/gui/macosx/macosx.m:65
msgid "Shows a lucent controller when moving the mouse in fullscreen mode."
msgstr "ສະແດງຕົວຄວບຄຸມແບບໂປ່ງແສງເມື່ອເລື່ອນເມົາສ໌ໃນໂໝດເຕັມຈໍ."

#: modules/gui/macosx/macosx.m:68
msgid "Auto-playback of new items"
msgstr "ຫຼິ້ນລາຍການໃໝ່ໂດຍອັດຕະໂນມັດ"

#: modules/gui/macosx/macosx.m:69
msgid "Start playback of new items immediately once they were added."
msgstr "ເລີ່ມຫຼິ້ນລາຍການໃໝ່ທັນທີເມື່ອຖືກເພີ່ມເຂົ້າໄປ."

#: modules/gui/macosx/macosx.m:72
msgid "Keep Recent Items"
msgstr "ເກັບຮັກສາລາຍການຫຼ້າສຸດ"

#: modules/gui/macosx/macosx.m:73
msgid ""
"By default, VLC keeps a list of the last 10 items. This feature can be "
"disabled here."
msgstr "ໂດຍປົກກະຕິ VLC ຈະເກັບລາຍຊື່ 10 ລາຍການຫຼ້າສຸດໄວ້. ທ່ານສາມາດປິດຄຸນສົມບັດນີ້ໄດ້ທີ່ນີ້."

#: modules/gui/macosx/macosx.m:76
#: modules/gui/macosx/VLCSimplePrefsController.m:311
msgid "Control playback with the Apple Remote"
msgstr "ຄວບຄຸມການຫຼິ້ນດ້ວຍ Apple Remote"

#: modules/gui/macosx/macosx.m:77
msgid "By default, VLC can be remotely controlled with the Apple Remote."
msgstr "ໂດຍປົກກະຕິ VLC ສາມາດຄວບຄຸມໄດ້ດ້ວຍ Apple Remote."

#: modules/gui/macosx/macosx.m:79
#: modules/gui/macosx/VLCSimplePrefsController.m:313
msgid "Control system volume with the Apple Remote"
msgstr "ຄວບຄຸມລະດັບສຽງຂອງລະບົບດ້ວຍ Apple Remote"

#: modules/gui/macosx/macosx.m:80
msgid ""
"By default, VLC will control its own volume with the Apple Remote. However, "
"you can choose to control the global system volume instead."
msgstr "ໂດຍປົກກະຕິ VLC ຈະຄວບຄຸມລະດັບສຽງຂອງຕົວມັນເອງ, ແຕ່ທ່ານສາມາດເລືອກໃຫ້ມັນຄວບຄຸມລະດັບສຽງຂອງທັງລະບົບໄດ້."

#: modules/gui/macosx/macosx.m:82
#: modules/gui/macosx/VLCSimplePrefsController.m:314
msgid "Display VLC status menu icon"
msgstr "ສະແດງໄອຄອນເມນູສະຖານະຂອງ VLC"

#: modules/gui/macosx/macosx.m:83
msgid ""
"By default, VLC will show the statusbar icon menu. However, you can choose "
"to disable it (restart required)."
msgstr "ໂດຍປົກກະຕິ VLC ຈະສະແດງໄອຄອນເທິງແຖບສະຖານະ. ທ່ານສາມາດປິດມັນໄດ້ (ຕ້ອງເລີ່ມໂປຣແກຣມໃໝ່)."

#: modules/gui/macosx/macosx.m:85
msgid "Control playlist items with the Apple Remote"
msgstr "ຄວບຄຸມລາຍການໃນຜັງລາຍການດ້ວຍ Apple Remote"

#: modules/gui/macosx/macosx.m:86
msgid ""
"By default, VLC will allow you to switch to the next or previous item with "
"the Apple Remote. You can disable this behavior with this option."
msgstr "ໂດຍປົກກະຕິ VLC ຈະອະນຸຍາດໃຫ້ປ່ຽນລາຍການໂດຍໃຊ້ Apple Remote."

#: modules/gui/macosx/macosx.m:88
#: modules/gui/macosx/VLCSimplePrefsController.m:312
msgid "Control playback with media keys"
msgstr "ຄວບຄຸມການຫຼິ້ນດ້ວຍປຸ່ມມີເດຍ"

#: modules/gui/macosx/macosx.m:89
msgid ""
"By default, VLC can be controlled using the media keys on modern Apple "
"keyboards."
msgstr "ໂດຍປົກກະຕິ VLC ສາມາດຄວບຄຸມໄດ້ຜ່ານປຸ່ມມີເດຍເທິງຄີບອດຂອງ Apple."

#: modules/gui/macosx/macosx.m:92
msgid "Run VLC with dark interface style"
msgstr "ເປີດໃຊ້ VLC ດ້ວຍຮູບແບບສ່ວນຕິດຕໍ່ສີເຂັ້ມ"

#: modules/gui/macosx/macosx.m:93
msgid ""
"If this option is enabled, VLC will use the dark interface style. Otherwise, "
"the grey interface style is used."
msgstr "ຖ້າເປີດໃຊ້ງານ, VLC ຈະໃຊ້ຮູບແບບສີເຂັ້ມ. ຖ້າບໍ່ດັ່ງນັ້ນ ຈະໃຊ້ຮູບແບບສີເທົ່າ."

#: modules/gui/macosx/macosx.m:95
#: modules/gui/macosx/VLCSimplePrefsController.m:356
msgid "Use the native fullscreen mode"
msgstr "ໃຊ້ໂໝດເຕັມຈໍແບບດັ້ງເດີມ"

#: modules/gui/macosx/macosx.m:96
msgid ""
"By default, VLC uses the fullscreen mode known from previous Mac OS X "
"releases. It can also use the native fullscreen mode on Mac OS X 10.7 and "
"later."
msgstr "ໃຊ້ໂໝດເຕັມຈໍມາດຕະຖານຂອງລະບົບ Mac OS X 10.7 ຫຼື ໃໝ່ກວ່າ."

#: modules/gui/macosx/macosx.m:98 modules/gui/qt/qt.cpp:95
msgid "Resize interface to the native video size"
msgstr "ປັບຂະໜາດສ່ວນຕິດຕໍ່ຕາມຂະໜາດວິດີໂອຕົ້ນສະບັບ"

#: modules/gui/macosx/macosx.m:99 modules/gui/qt/qt.cpp:96
msgid ""
"You have two choices:\n"
" - The interface will resize to the native video size\n"
" - The video will fit to the interface size\n"
" By default, interface resize to the native video size."
msgstr ""
"ທ່ານມີສອງທາງເລືອກ:\n"
" - ສ່ວນຕິດຕໍ່ຈະປັບຂະໜາດຕາມວິດີໂອຕົ້ນສະບັບ\n"
" - ວິດີໂອຈະປັບໃຫ້ພໍດີກັບຂະໜາດຂອງສ່ວນຕິດຕໍ່\n"
" ໂດຍປົກກະຕິ ສ່ວນຕິດຕໍ່ຈະປັບຕາມຂະໜາດວິດີໂອຕົ້ນສະບັບ."

#: modules/gui/macosx/macosx.m:104
#: modules/gui/macosx/VLCSimplePrefsController.m:349 modules/gui/qt/qt.cpp:178
msgid "Pause the video playback when minimized"
msgstr "ຢຸດການຫຼິ້ນວິດີໂອຊົ່ວຄາວເມື່ອຍໍ້ໜ້າຕ່າງລົງ"

#: modules/gui/macosx/macosx.m:105 modules/gui/qt/qt.cpp:180
msgid ""
"With this option enabled, the playback will be automatically paused when "
"minimizing the window."
msgstr "ຖ້າເປີດໃຊ້ງານ, ການຫຼິ້ນຈະຢຸດຊົ່ວຄາວໂດຍອັດຕະໂນມັດເມື່ອຍໍ້ໜ້າຕ່າງລົງ."

#: modules/gui/macosx/macosx.m:108 modules/gui/qt/qt.cpp:182
msgid "Allow automatic icon changes"
msgstr "ອະນຸຍາດໃຫ້ປ່ຽນໄອຄອນໂດຍອັດຕະໂນມັດ"

#: modules/gui/macosx/macosx.m:109 modules/gui/qt/qt.cpp:184
msgid ""
"This option allows the interface to change its icon on various occasions."
msgstr "ທາງເລືອກນີ້ອະນຸຍາດໃຫ້ປ່ຽນໄອຄອນໃນໂອກາດຕ່າງໆ."

#: modules/gui/macosx/macosx.m:111 modules/gui/macosx/VLCMainMenu.m:1445
msgid "Lock Aspect Ratio"
msgstr "ລັອກອັດຕາສ່ວນພາບ"

#: modules/gui/macosx/macosx.m:113
msgid "Dim keyboard backlight during fullscreen playback"
msgstr "ຫຼຸດແສງໄຟຄີບອດໃນເວລາຫຼິ້ນແບບເຕັມຈໍ"

#: modules/gui/macosx/macosx.m:114
msgid ""
"Turn off the MacBook keyboard backlight while a video is playing in "
"fullscreen. Automatic brightness adjustment should be disabled in System "
"Preferences."
msgstr "ປິດໄຟຄີບອດ MacBook ໃນຂະນະທີ່ຫຼິ້ນວິດີໂອແບບເຕັມຈໍ."

#: modules/gui/macosx/macosx.m:116 modules/gui/macosx/VLCMainMenu.m:366
msgid "Show Previous & Next Buttons"
msgstr "ສະແດງປຸ່ມ ກ່ອນໜ້າ ແລະ ຖັດໄປ"

#: modules/gui/macosx/macosx.m:117
msgid "Shows the previous and next buttons in the main window."
msgstr "ສະແດງປຸ່ມກ່ອນໜ້າ ແລະ ຖັດໄປໃນໜ້າຕ່າງຫຼັກ."

#: modules/gui/macosx/macosx.m:119 modules/gui/macosx/VLCMainMenu.m:368
msgid "Show Shuffle & Repeat Buttons"
msgstr "ສະແດງປຸ່ມ ຊຸ່ມ ແລະ ຫຼິ້ນຊ້ຳ"

#: modules/gui/macosx/macosx.m:120
msgid "Shows the shuffle and repeat buttons in the main window."
msgstr "ສະແດງປຸ່ມຊຸ່ມ ແລະ ຫຼິ້ນຊ້ຳໃນໜ້າຕ່າງຫຼັກ."

#: modules/gui/macosx/macosx.m:122 modules/gui/macosx/VLCMainMenu.m:370
msgid "Show Audio Effects Button"
msgstr "ສະແດງປຸ່ມເອັບເຟັກສຽງ"

#: modules/gui/macosx/macosx.m:123
msgid "Shows the audio effects button in the main window."
msgstr "ສະແດງປຸ່ມເອັບເຟັກສຽງໃນໜ້າຕ່າງຫຼັກ."

