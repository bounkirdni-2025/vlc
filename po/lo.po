msgstr "URL ຂອງ SDP"

#: modules/gui/macosx/VLCConvertAndSaveWindowController.m:270
msgid "Invalid container format for HTTP streaming"
msgstr "ຮູບແບບຄອນເທນເນີບໍ່ຖືກຕ້ອງສຳລັບການສະຕຣີມຜ່ານ HTTP"

#: modules/gui/macosx/VLCConvertAndSaveWindowController.m:272
msgid ""
"Media encapsulated as %@ cannot be streamed through the HTTP protocol for "
"technical reasons."
msgstr "ສື່ທີ່ຖືກຫຸ້ມຫໍ່ເປັນ %@ ບໍ່ສາມາດສະຕຣີມຜ່ານໂປຣໂຕຄໍ HTTP ໄດ້ຍ້ອນເຫດຜົນທາງເຕັກນິກ."

#: modules/gui/macosx/VLCConvertAndSaveWindowController.m:336
msgid "Remove a profile"
msgstr "ລຶບໂປຣໄຟລ໌ອອກ"

#: modules/gui/macosx/VLCConvertAndSaveWindowController.m:337
msgid "Select the profile you would like to remove:"
msgstr "ເລືອກໂປຣໄຟລ໌ທີ່ທ່ານຕ້ອງການລຶບອອກ:"

#: modules/gui/macosx/VLCConvertAndSaveWindowController.m:473
msgid "Save as new profile"
msgstr "ບັນທຶກເປັນໂປຣໄຟລ໌ໃໝ່"

#: modules/gui/macosx/VLCConvertAndSaveWindowController.m:522
msgid "%@ stream to %@:%@"
msgstr "%@ ສະຕຣີມໄປຍັງ %@:%@"

#: modules/gui/macosx/VLCConvertAndSaveWindowController.m:531
msgid "No Address given"
msgstr "ບໍ່ມີທີ່ຢູ່ທີ່ລະບຸໄວ້"

#: modules/gui/macosx/VLCConvertAndSaveWindowController.m:533
msgid "In order to stream, a valid destination address is required."
msgstr "ເພື່ອທີ່ຈະສະຕຣີມ, ທ່ານຕ້ອງລະບຸທີ່ຢູ່ປາຍທາງທີ່ຖືກຕ້ອງ."

#: modules/gui/macosx/VLCConvertAndSaveWindowController.m:538
msgid "No Channel Name given"
msgstr "ບໍ່ມີຊື່ຊ່ອງທີ່ລະບຸໄວ້"

#: modules/gui/macosx/VLCConvertAndSaveWindowController.m:540
msgid ""
"SAP stream announcement is enabled. However, no channel name is provided."
msgstr "ການປະກາດສະຕຣີມ SAP ຖືກເປີດໃຊ້, ແຕ່ຍັງບໍ່ມີການລະບຸຊື່ຊ່ອງ."

#: modules/gui/macosx/VLCConvertAndSaveWindowController.m:545
msgid "No SDP URL given"
msgstr "ບໍ່ມີ URL ຂອງ SDP ທີ່ລະບຸໄວ້"

#: modules/gui/macosx/VLCConvertAndSaveWindowController.m:547
msgid "A SDP export is requested, but no URL is provided."
msgstr "ມີການຮ້ອງຂໍການສົ່ງອອກ SDP, ແຕ່ຍັງບໍ່ມີການລະບຸ URL."

