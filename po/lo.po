#: modules/codec/avcodec/avcodec.h:56
msgid "Direct rendering"
msgstr "ການສະແດງຜົນໂດຍກົງ"

#: modules/codec/avcodec/avcodec.h:59
msgid "Show corrupted frames"
msgstr "ສະແດງເຟຣມທີ່ເສຍຫາຍ"

#: modules/codec/avcodec/avcodec.h:60
msgid "Prefer visual artifacts instead of missing frames"
msgstr "ເລືອກໃຫ້ສະແດງພາບທີ່ຜິດພ້ຽນ ແທນທີ່ເຟຣມຈະຫາຍໄປ"

#: modules/codec/avcodec/avcodec.h:62
msgid "Error resilience"
msgstr "ຄວາມທົນທານຕໍ່ຂໍ້ຜິດພາດ"

#: modules/codec/avcodec/avcodec.h:64
msgid ""
"libavcodec can do error resilience.\n"
"However, with a buggy encoder (such as the ISO MPEG-4 encoder from M$) this "
"can produce a lot of errors.\n"
"Valid values range from 0 to 4 (0 disables all errors resilience)."
msgstr ""
"libavcodec ສາມາດເຮັດຄວາມທົນທານຕໍ່ຂໍ້ຜິດພາດໄດ້.\n"
"ແນວໃດກໍຕາມ, ຫາກໃຊ້ຕົວເຂົ້າລະຫັດທີ່ມີບັກ (ເຊັ່ນຕົວເຂົ້າລະຫັດ ISO MPEG-4 ຈາກ M$) ສິ່ງນີ້ອາດເຮັດໃຫ້ເກີດຂໍ້ຜິດພາດຫຼາຍຂຶ້ນ.\n"
"ຄ່າທີ່ໃຊ້ໄດ້ແມ່ນຕັ້ງແຕ່ 0 ຫາ 4 (0 ແມ່ນປິດຄວາມທົນທານຕໍ່ຂໍ້ຜິດພາດທັງໝົດ)."

#: modules/codec/avcodec/avcodec.h:69
msgid "Workaround bugs"
msgstr "ວິທີແກ້ໄຂບັນຫາບັກ"

#: modules/codec/avcodec/avcodec.h:71
msgid ""
"Try to fix some bugs:\n"
"1  autodetect\n"
"2  old msmpeg4\n"
"4  xvid interlaced\n"
"8  ump4 \n"
"16 no padding\n"
"32 ac vlc\n"
"64 Qpel chroma.\n"
"This must be the sum of the values. For example, to fix \"ac vlc\" and "
"\"ump4\", enter 40."
msgstr ""
"ພະຍາຍາມແກ້ໄຂບາງບັກ:\n"
"1  ກວດສອບອັດຕະໂນມັດ\n"
"2  msmpeg4 ລຸ້ນເກົ່າ\n"
"4  xvid ແບບແຊກເສັ້ນ (interlaced)\n"
"8  ump4 \n"
"16 ບໍ່ມີການເຕີມຊ່ອງຫວ່າງ (no padding)\n"
"32 ac vlc\n"
"64 Qpel chroma.\n"
"ຄ່ານີ້ຕ້ອງແມ່ນຜົນລວມຂອງຄ່າຕ່າງໆ. ຕົວຢ່າງ, ເພື່ອແກ້ໄຂ \"ac vlc\" ແລະ \"ump4\", ໃຫ້ປ້ອນ 40."

#: modules/codec/avcodec/avcodec.h:82 modules/codec/avcodec/avcodec.h:177
#: modules/demux/rawdv.c:42
msgid "Hurry up"
msgstr "ເລັ່ງຄວາມໄວ"

#: modules/codec/avcodec/avcodec.h:84
msgid ""
"The decoder can partially decode or skip frame(s) when there is not enough "
"time. It's useful with low CPU power but it can produce distorted pictures."
msgstr "ຕົວຖອດລະຫັດສາມາດຖອດລະຫັດບາງສ່ວນ ຫຼື ຂ້າມເຟຣມໄດ້ເມື່ອມີເວລາບໍ່ພຽງພໍ. ມັນມີປະໂຫຍດກັບເຄື່ອງທີ່ມີ CPU ຕ່ຳ ແຕ່ມັນອາດເຮັດໃຫ້ພາບຜິດພ້ຽນໄດ້."

#: modules/codec/avcodec/avcodec.h:88
msgid "Allow speed tricks"
msgstr "ອະນຸຍາດໃຫ້ໃຊ້ເຕັກນິກເລັ່ງຄວາມໄວ"

#: modules/codec/avcodec/avcodec.h:90
msgid ""
"Allow non specification compliant speedup tricks. Faster but error-prone."
msgstr "ອະນຸຍາດໃຫ້ໃຊ້ເຕັກນິກເລັ່ງຄວາມໄວທີ່ບໍ່ເປັນໄປຕາມມາດຕະຖານ. ໄວຂຶ້ນແຕ່ອາດເກີດຂໍ້ຜິດພາດໄດ້ງ່າຍ."

#: modules/codec/avcodec/avcodec.h:92
msgid "Skip frame (default=0)"
msgstr "ຂ້າມເຟຣມ (ຄ່າເລີ່ມຕົ້ນ=0)"

#: modules/codec/avcodec/avcodec.h:94
msgid ""
"Force skipping of frames to speed up decoding (-1=None, 0=Default, 1=B-"
"frames, 2=P-frames, 3=B+P frames, 4=all frames)."
msgstr "ບັງຄັບການຂ້າມເຟຣມເພື່ອເລັ່ງການຖອດລະຫັດ (-1=ບໍ່ຂ້າມ, 0=ຄ່າເລີ່ມຕົ້ນ, 1=B-frames, 2=P-frames, 3=B+P frames, 4=ທຸກເຟຣມ)."

#: modules/codec/avcodec/avcodec.h:97
msgid "Skip idct (default=0)"
msgstr "ຂ້າມ idct (ຄ່າເລີ່ມຕົ້ນ=0)"

#: modules/codec/avcodec/avcodec.h:99
msgid ""
"Force skipping of idct to speed up decoding for frame types (-1=None, "
"0=Default, 1=B-frames, 2=P-frames, 3=B+P frames, 4=all frames)."
msgstr "ບັງຄັບການຂ້າມ idct ເພື່ອເລັ່ງການຖອດລະຫັດສຳລັບປະເພດເຟຣມ (-1=ບໍ່ຂ້າມ, 0=ຄ່າເລີ່ມຕົ້ນ, 1=B-frames, 2=P-frames, 3=B+P frames, 4=ທຸກເຟຣມ)."

#: modules/codec/avcodec/avcodec.h:102
msgid "Debug mask"
msgstr "ມາກສ໌ກວດສອບຂໍ້ຜິດພາດ (Debug mask)"

#: modules/codec/avcodec/avcodec.h:103
msgid "Set FFmpeg debug mask"
msgstr "ຕັ້ງຄ່າ FFmpeg debug mask"

#: modules/codec/avcodec/avcodec.h:105
msgid "Codec name"
msgstr "ຊື່ໂຄເດັກ (Codec)"

#: modules/codec/avcodec/avcodec.h:106
msgid "Internal libavcodec codec name"
msgstr "ຊື່ໂຄເດັກພາຍໃນຂອງ libavcodec"

#: modules/codec/avcodec/avcodec.h:108
#: modules/gui/macosx/VLCSimplePrefsController.m:292
msgid "Skip the loop filter for H.264 decoding"
msgstr "ຂ້າມການກອງລູບ (loop filter) ສຳລັບການຖອດລະຫັດ H.264"

#: modules/codec/avcodec/avcodec.h:109
msgid ""
"Skipping the loop filter (aka deblocking) usually has a detrimental effect "
"on quality. However it provides a big speedup for high definition streams."
msgstr "ການຂ້າມການກອງລູບ (ຫຼື deblocking) ໂດຍປົກກະຕິຈະສົ່ງຜົນເສຍຕໍ່ຄຸນນະພາບ. ແນວໃດກໍຕາມ ມັນຈະຊ່ວຍເລັ່ງຄວາມໄວໄດ້ຫຼາຍສຳລັບສະຕຣີມທີ່ມີຄວາມລະອຽດສູງ."

#: modules/codec/avcodec/avcodec.h:113
msgid "Hardware decoding"
msgstr "ການຖອດລະຫັດດ້ວຍຮາດແວ"

#: modules/codec/avcodec/avcodec.h:114
msgid "This allows hardware decoding when available."
msgstr "ອະນຸຍາດໃຫ້ຖອດລະຫັດດ້ວຍຮາດແວເມື່ອສາມາດໃຊ້ໄດ້."

#: modules/codec/avcodec/avcodec.h:116
msgid "Threads"
msgstr "ເທຣດ (Threads)"

#: modules/codec/avcodec/avcodec.h:117
msgid "Number of threads used for decoding, 0 meaning auto"
msgstr "ຈຳນວນເທຣດທີ່ໃຊ້ໃນການຖອດລະຫັດ, 0 ໝາຍເຖິງອັດຕະໂນມັດ"

#: modules/codec/avcodec/avcodec.h:124
msgid "Ratio of key frames"
msgstr "ອັດຕາສ່ວນຂອງເຟຣມຫຼັກ (key frames)"

#: modules/codec/avcodec/avcodec.h:125
msgid "Number of frames that will be coded for one key frame."
msgstr "ຈຳນວນເຟຣມທີ່ຈະຖືກເຂົ້າລະຫັດຕໍ່ໜຶ່ງເຟຣມຫຼັກ."

#: modules/codec/avcodec/avcodec.h:128
msgid "Ratio of B frames"
msgstr "ອັດຕາສ່ວນຂອງ B frames"

#: modules/codec/avcodec/avcodec.h:129
msgid "Number of B frames that will be coded between two reference frames."
msgstr "ຈຳນວນ B framesທີ່ຈະຖືກເຂົ້າລະຫັດລະຫວ່າງສອງເຟຣມອ້າງອີງ."

#: modules/codec/avcodec/avcodec.h:132
msgid "Video bitrate tolerance"
msgstr "ຄວາມຄາດເຄື່ອນຂອງບິດເຣດວິດີໂອ"

#: modules/codec/avcodec/avcodec.h:133
msgid "Video bitrate tolerance in kbit/s."
msgstr "ຄວາມຄາດເຄື່ອນຂອງບິດເຣດວິດີໂອເປັນ kbit/s."

#: modules/codec/avcodec/avcodec.h:135
msgid "Interlaced encoding"
msgstr "ການເຂົ້າລະຫັດແບບແຊກເສັ້ນ (Interlaced)"

#: modules/codec/avcodec/avcodec.h:136
msgid "Enable dedicated algorithms for interlaced frames."
msgstr "ເປີດໃຊ້ງານອັນກໍຣິທຶມສະເພາະສຳລັບເຟຣມແບບແຊກເສັ້ນ."

#: modules/codec/avcodec/avcodec.h:139
msgid "Interlaced motion estimation"
msgstr "ການຄາດຄະເນການເຄື່ອນໄຫວແບບແຊກເສັ້ນ"

#: modules/codec/avcodec/avcodec.h:140
msgid "Enable interlaced motion estimation algorithms. This requires more CPU."
msgstr "ເປີດໃຊ້ອັນກໍຣິທຶມການຄາດຄະເນການເຄື່ອນໄຫວແບບແຊກເສັ້ນ. ສິ່ງນີ້ຕ້ອງໃຊ້ CPU ຫຼາຍຂຶ້ນ."

#: modules/codec/avcodec/avcodec.h:143
msgid "Pre-motion estimation"
msgstr "ການຄາດຄະເນການເຄື່ອນໄຫວລ່ວງໜ້າ"

#: modules/codec/avcodec/avcodec.h:144
msgid "Enable the pre-motion estimation algorithm."
msgstr "ເປີດໃຊ້ອັນກໍຣິທຶມການຄາດຄະເນການເຄື່ອນໄຫວລ່ວງໜ້າ."

#: modules/codec/avcodec/avcodec.h:147
msgid "Rate control buffer size"
msgstr "ຂະໜາດບັບເຟີສຳລັບຄວບຄຸມອັດຕາບິດ"

#: modules/codec/avcodec/avcodec.h:148
msgid ""
"Rate control buffer size (in kbytes). A bigger buffer will allow for better "
"rate control, but will cause a delay in the stream."
msgstr "ຂະໜາດບັບເຟີສຳລັບຄວບຄຸມອັດຕາບິດ (ເປັນ kbytes). ບັບເຟີທີ່ໃຫຍ່ຂຶ້ນຈະຊ່ວຍໃຫ້ການຄວບຄຸມອັດຕາບິດດີຂຶ້ນ ແຕ່ຈະເຮັດໃຫ້ເກີດການຊັກຊ້າໃນສະຕຣີມ."

#: modules/codec/avcodec/avcodec.h:152
msgid "Rate control buffer aggressiveness"
msgstr "ຄວາມເຂັ້ມງວດຂອງບັບເຟີຄວບຄຸມອັດຕາບິດ"

#: modules/codec/avcodec/avcodec.h:153
msgid "Rate control buffer aggressiveness."
msgstr "ຄວາມເຂັ້ມງວດຂອງບັບເຟີຄວບຄຸມອັດຕາບິດ."

#: modules/codec/avcodec/avcodec.h:156
msgid "I quantization factor"
msgstr "ຕົວຄູນຄຳນວນ (quantization) ຂອງ I frame"

#: modules/codec/avcodec/avcodec.h:158
msgid ""
"Quantization factor of I frames, compared with P frames (for instance 1.0 => "
"same qscale for I and P frames)."
msgstr "ຕົວຄູນການຄຳນວນຂອງ I frames ເມື່ອທຽບກັບ P frames (ຕົວຢ່າງ 1.0 => ໃຊ້ qscale ດຽວກັນສຳລັບ I ແລະ P frames)."

#: modules/codec/avcodec/avcodec.h:161 modules/codec/x264.c:369
#: modules/demux/mod.c:79
msgid "Noise reduction"
msgstr "ການຫຼຸດສຽງລົບກວນ"

#: modules/codec/avcodec/avcodec.h:162
msgid ""
"Enable a simple noise reduction algorithm to lower the encoding length and "
"bitrate, at the expense of lower quality frames."
msgstr "ເປີດໃຊ້ອັນກໍຣິທຶມຫຼຸດສຽງລົບກວນແບບງ່າຍ ເພື່ອຫຼຸດຄວາມຍາວການເຂົ້າລະຫັດ ແລະ ບິດເຣດ, ແຕ່ອາດເຮັດໃຫ້ຄຸນນະພາບຂອງເຟຣມຕ່ຳລົງ."

#: modules/codec/avcodec/avcodec.h:166
msgid "MPEG4 quantization matrix"
msgstr "ແມັດທຣິກການຄຳນວນ (quantization) ຂອງ MPEG4"

#: modules/codec/avcodec/avcodec.h:167
msgid ""
"Use the MPEG4 quantization matrix for MPEG2 encoding. This generally yields "
"a better looking picture, while still retaining the compatibility with "
"standard MPEG2 decoders."
msgstr "ໃຊ້ແມັດທຣິກການຄຳນວນຂອງ MPEG4 ສຳລັບການເຂົ້າລະຫັດ MPEG2. ໂດຍທົ່ວໄປແລ້ວຈະໃຫ້ພາບທີ່ເບິ່ງດີກວ່າ ໃນຂະນະທີ່ຍັງຮັກສາຄວາມເຂົ້າກັນໄດ້ກັບຕົວຖອດລະຫັດ MPEG2 ມາດຕະຖານ."

#: modules/codec/avcodec/avcodec.h:172 modules/codec/jpeg.c:51
msgid "Quality level"
msgstr "ລະດັບຄຸນນະພາບ"

#: modules/codec/avcodec/avcodec.h:173
msgid ""
"Quality level for the encoding of motions vectors (this can slow down the "
"encoding very much)."
msgstr "ລະດັບຄຸນນະພາບສຳລັບການເຂົ້າລະຫັດ motion vectors (ສິ່ງນີ້ອາດເຮັດໃຫ້ການເຂົ້າລະຫັດຊ້າລົງຫຼາຍ)."

#: modules/codec/avcodec/avcodec.h:178
msgid ""
"The encoder can make on-the-fly quality tradeoffs if your CPU can't keep up "
"with the encoding rate. It will disable trellis quantization, then the rate "
"distortion of motion vectors (hq), and raise the noise reduction threshold "
"to ease the encoder's task."
msgstr "ຕົວເຂົ້າລະຫັດສາມາດປັບປ່ຽນຄຸນນະພາບໄດ້ທັນທີ ຫາກ CPU ຂອງທ່ານເຂົ້າລະຫັດບໍ່ທັນ. ມັນຈະປິດການຄຳນວນແບບ trellis, ຫຼັງຈາກນັ້ນປິດ rate distortion ຂອງ motion vectors (hq), ແລະ ເພີ່ມເກນການຫຼຸດສຽງລົບກວນເພື່ອຫຼຸດພາລະຂອງຕົວເຂົ້າລະຫັດ."

#: modules/codec/avcodec/avcodec.h:184
msgid "Minimum video quantizer scale"
msgstr "ຂະໜາດຕົວຄຳນວນວິດີໂອຕ່ຳສຸດ"

#: modules/codec/avcodec/avcodec.h:185
msgid "Minimum video quantizer scale."
msgstr "ຂະໜາດຕົວຄຳນວນວິດີໂອຕ່ຳສຸດ."

#: modules/codec/avcodec/avcodec.h:188
msgid "Maximum video quantizer scale"
msgstr "ຂະໜາດຕົວຄຳນວນວິດີໂອສູງສຸດ"

#: modules/codec/avcodec/avcodec.h:189
msgid "Maximum video quantizer scale."
msgstr "ຂະໜາດຕົວຄຳນວນວິດີໂອສູງສຸດ."

#: modules/codec/avcodec/avcodec.h:192
msgid "Trellis quantization"
msgstr "ການຄຳນວນແບບ Trellis"

#: modules/codec/avcodec/avcodec.h:193
msgid "Enable trellis quantization (rate distortion for block coefficients)."
msgstr "ເປີດໃຊ້ການຄຳນວນແບບ trellis (rate distortion ສຳລັບສຳປະສິດບລັອກ)."

#: modules/codec/avcodec/avcodec.h:196
msgid "Fixed quantizer scale"
msgstr "ຂະໜາດຕົວຄຳນວນແບບຄົງທີ່"

#: modules/codec/avcodec/avcodec.h:197
msgid ""
"A fixed video quantizer scale for VBR encoding (accepted values: 0.01 to "
"255.0)."
msgstr "ຂະໜາດຕົວຄຳນວນວິດີໂອແບບຄົງທີ່ສຳລັບການເຂົ້າລະຫັດ VBR (ຄ່າທີ່ຍອມຮັບ: 0.01 ຫາ 255.0)."

#: modules/codec/avcodec/avcodec.h:200
msgid "Strict standard compliance"
msgstr "ການປະຕິບັດຕາມມາດຕະຖານຢ່າງເຂັ້ມງວດ"

#: modules/codec/avcodec/avcodec.h:201
msgid ""
"Force a strict standard compliance when encoding (accepted values: -2 to 2)."
msgstr "ບັງຄັບໃຫ້ປະຕິບັດຕາມມາດຕະຖານຢ່າງເຂັ້ມງວດເມື່ອເຂົ້າລະຫັດ (ຄ່າທີ່ຍອມຮັບ: -2 ຫາ 2)."

#: modules/codec/avcodec/avcodec.h:204
msgid "Luminance masking"
msgstr "ການປິດບັງຄວາມສະຫວ່າງ (Luminance masking)"

#: modules/codec/avcodec/avcodec.h:205
msgid "Raise the quantizer for very bright macroblocks (default: 0.0)."
msgstr "ເພີ່ມການຄຳນວນສຳລັບ macroblocks ທີ່ມີຄວາມສະຫວ່າງຫຼາຍ (ຄ່າເລີ່ມຕົ້ນ: 0.0)."

#: modules/codec/avcodec/avcodec.h:208
msgid "Darkness masking"
msgstr "ການປິດບັງຄວາມມືດ (Darkness masking)"

#: modules/codec/avcodec/avcodec.h:209
msgid "Raise the quantizer for very dark macroblocks (default: 0.0)."
msgstr "ເພີ່ມການຄຳນວນສຳລັບ macroblocks ທີ່ມີຄວາມມືດຫຼາຍ (ຄ່າເລີ່ມຕົ້ນ: 0.0)."

#: modules/codec/avcodec/avcodec.h:212
msgid "Motion masking"
msgstr "ການປິດບັງການເຄື່ອນໄຫວ (Motion masking)"

#: modules/codec/avcodec/avcodec.h:213
msgid ""
"Raise the quantizer for macroblocks with a high temporal complexity "
"(default: 0.0)."
msgstr "ເພີ່ມການຄຳນວນສຳລັບ macroblocks ທີ່ມີຄວາມຊັບຊ້ອນທາງເວລາສູງ (ຄ່າເລີ່ມຕົ້ນ: 0.0)."

#: modules/codec/avcodec/avcodec.h:216
msgid "Border masking"
msgstr "ການປິດບັງຂອບ (Border masking)"

#: modules/codec/avcodec/avcodec.h:217
msgid ""
"Raise the quantizer for macroblocks at the border of the frame (default: "
"0.0)."
msgstr "ເພີ່ມການຄຳນວນສຳລັບ macroblocks ທີ່ຢູ່ບໍລິເວນຂອບຂອງເຟຣມ (ຄ່າເລີ່ມຕົ້ນ: 0.0)."

#: modules/codec/avcodec/avcodec.h:220
msgid "Luminance elimination"
msgstr "ການກຳຈັດຄວາມສະຫວ່າງ"

#: modules/codec/avcodec/avcodec.h:221
msgid ""
"Eliminates luminance blocks when the PSNR isn't much changed (default: 0.0). "
"The H264 specification recommends -4."
msgstr "ກຳຈັດບລັອກຄວາມສະຫວ່າງເມື່ອ PSNR ບໍ່ປ່ຽນແປງຫຼາຍ (ຄ່າເລີ່ມຕົ້ນ: 0.0). ມາດຕະຖານ H264 ແນະນຳໃຫ້ໃຊ້ -4."

#: modules/codec/avcodec/avcodec.h:225
msgid "Chrominance elimination"
msgstr "ການກຳຈັດສີ (Chrominance elimination)"

#: modules/codec/avcodec/avcodec.h:226
msgid ""
"Eliminates chrominance blocks when the PSNR isn't much changed (default: "
"0.0). The H264 specification recommends 7."
msgstr "ກຳຈັດບລັອກສີເມື່ອ PSNR ບໍ່ປ່ຽນແປງຫຼາຍ (ຄ່າເລີ່ມຕົ້ນ: 0.0). ມາດຕະຖານ H264 ແນະນຳໃຫ້ໃຊ້ 7."

#: modules/codec/avcodec/avcodec.h:230
msgid "Specify AAC audio profile to use"
msgstr "ລະບຸໂປຣໄຟລ໌ສຽງ AAC ທີ່ຈະໃຊ້"

#: modules/codec/avcodec/avcodec.h:231
msgid ""
"Specify the AAC audio profile to use for encoding the audio bitstream. It "
"takes the following options: main, low, ssr (not supported),ltp, hev1, hev2 "
"(default: low). hev1 and hev2 are currently supported only with libfdk-aac "
"enabled libavcodec"
msgstr ""
"ລະບຸໂປຣໄຟລ໌ສຽງ AAC ທີ່ຈະໃຊ້ສຳລັບການເຂົ້າລະຫັດບິດສຕຣີມສຽງ. ມີຕົວເລືອກດັ່ງນີ້: main, low, ssr (ບໍ່ຮອງຮັບ), ltp, hev1, hev2 "
"(ຄ່າເລີ່ມຕົ້ນ: low). hev1 ແລະ hev2 ໃນປັດຈຸບັນຮອງຮັບສະເພາະກັບ libavcodec ທີ່ເປີດໃຊ້ libfdk-aac ເທົ່ານັ້ນ"

#: modules/codec/avcodec/d3d11va.c:63
msgid "Direct3D11 Video Acceleration"
msgstr "ການເລັ່ງຄວາມໄວວິດີໂອ Direct3D11"

#: modules/codec/avcodec/dxva2.c:51
msgid "DirectX Video Acceleration (DXVA) 2.0"
msgstr "ການເລັ່ງຄວາມໄວວິດີໂອ DirectX (DXVA) 2.0"

#: modules/codec/avcodec/encoder.c:373
#, c-format
msgid ""
"It seems your Libav/FFmpeg (libavcodec) installation lacks the following "
"encoder:\n"
"%s.\n"
"If you don't know how to fix this, ask for support from your distribution.\n"
"\n"
"This is not an error inside VLC media player.\n"
"Do not contact the VideoLAN project about this issue.\n"
msgstr ""
"ເບິ່ງຄືວ່າການຕິດຕັ້ງ Libav/FFmpeg (libavcodec) ຂອງທ່ານຍັງຂາດຕົວເຂົ້າລະຫັດຕໍ່ໄປນີ້:\n"
"%s.\n"
"ຫາກທ່ານບໍ່ຮູ້ວິທີແກ້ໄຂ, ໃຫ້ສອບຖາມການຊ່ວຍເຫຼືອຈາກຜູ້ຜະລິດລະບົບປະຕິບັດການຂອງທ່ານ.\n"
"\n"
"ນີ້ບໍ່ແມ່ນຂໍ້ຜິດພາດພາຍໃນໂປຣແກຣມ VLC.\n"
"ກະລຸນາຢ່າຕິດຕໍ່ໂຄງການ VideoLAN ກ່ຽວກັບບັນຫານີ້.\n"

